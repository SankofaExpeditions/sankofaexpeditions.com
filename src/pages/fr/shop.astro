---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Boutique | Sankofa Expeditions';
const description = 'Livres, guides et outils pour la diaspora africaine de Sankofa Expeditions. Bientôt disponible.';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://sankofaexpeditions.com/fr/shop#webpage",
    "url": "https://sankofaexpeditions.com/fr/shop",
    "name": title,
    "description": description,
    "isPartOf": { "@id": "https://sankofaexpeditions.com/#website" },
    "about": { "@id": "https://sankofaexpeditions.com/#organization" },
    "inLanguage": "fr-FR",
    "datePublished": "2024-01-01",
    "dateModified": new Date().toISOString().split('T')[0]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://sankofaexpeditions.com/fr/shop"
  jsonLd={jsonLd}
>

  <section class="shop-cs" aria-labelledby="shop-cs-heading">
    <div class="container shop-cs-inner">
      <nav class="shop-cs-breadcrumb" aria-label="Fil d'Ariane">
        <ol>
          <li><a href="/fr">Accueil</a></li>
          <li aria-current="page">Boutique</li>
        </ol>
      </nav>

      <div class="shop-cs-badge">Bientôt Disponible</div>

      <h1 id="shop-cs-heading">La boutique arrive bientôt.</h1>

      <p class="shop-cs-desc">
        Livres, guides, manuels de terrain et outils pour la diaspora africaine.
        Nous construisons quelque chose qui vaut la peine d'être possédé. Revenez bientôt.
      </p>

      <div class="shop-cs-preview">
        <div class="shop-cs-item"><span aria-hidden="true">📖</span><span>Guides de Terrain</span></div>
        <div class="shop-cs-item"><span aria-hidden="true">🗺️</span><span>Manuels de Relocalisation</span></div>
        <div class="shop-cs-item"><span aria-hidden="true">📊</span><span>Rapports d'Intelligence</span></div>
        <div class="shop-cs-item"><span aria-hidden="true">🎓</span><span>Cours Numériques</span></div>
      </div>

      <p class="shop-cs-cta-text">En attendant, nos répertoires gratuits et notre blog sont ouverts et chargés d'intelligence.</p>

      <div class="shop-cs-actions">
        <a href="/directories" class="btn btn--primary">
          Parcourir les Répertoires Gratuits
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="https://sankofa-expeditions.beehiiv.com/subscribe" target="_blank" rel="noopener" class="btn btn--secondary">
          Recevoir la Newsletter Intel
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .shop-cs { min-height: 85vh; background: var(--color-dark); color: var(--color-text-on-dark); display: flex; align-items: center; justify-content: center; padding: var(--space-3xl) 0; position: relative; overflow: hidden; }
  .shop-cs::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(ellipse at 25% 50%, rgba(196, 132, 29, 0.08) 0%, transparent 60%), radial-gradient(ellipse at 75% 30%, rgba(196, 132, 29, 0.05) 0%, transparent 55%); pointer-events: none; }
  .shop-cs-inner { position: relative; z-index: 1; text-align: center; max-width: 640px; margin: 0 auto; }
  .shop-cs-breadcrumb { margin-bottom: var(--space-2xl); }
  .shop-cs-breadcrumb ol { display: flex; justify-content: center; align-items: center; gap: var(--space-sm); list-style: none; padding: 0; margin: 0; font-size: 0.85rem; }
  .shop-cs-breadcrumb li { display: flex; align-items: center; gap: var(--space-sm); color: var(--color-text-on-dark); opacity: 0.5; }
  .shop-cs-breadcrumb li + li::before { content: '→'; color: var(--color-gold); opacity: 0.4; }
  .shop-cs-breadcrumb a { color: var(--color-gold-light); text-decoration: none; opacity: 1; }
  .shop-cs-breadcrumb a:hover { text-decoration: underline; }
  .shop-cs-badge { display: inline-block; background: rgba(196, 132, 29, 0.15); border: 1px solid rgba(196, 132, 29, 0.35); color: var(--color-gold-light); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.4rem 1.2rem; border-radius: 100px; margin-bottom: var(--space-xl); }
  .shop-cs h1 { color: var(--color-text-light); font-size: clamp(2rem, 5vw, 3rem); margin-bottom: var(--space-lg); line-height: 1.1; }
  .shop-cs-desc { font-size: 1.1rem; color: var(--color-text-on-dark); opacity: 0.8; max-width: 480px; margin: 0 auto var(--space-2xl); line-height: 1.7; }
  .shop-cs-preview { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-md); margin-bottom: var(--space-2xl); }
  .shop-cs-item { display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-md); padding: 0.6rem 1.2rem; font-size: 0.9rem; color: var(--color-text-on-dark); opacity: 0.75; }
  .shop-cs-cta-text { font-size: 0.9rem; color: var(--color-text-on-dark); opacity: 0.55; margin-bottom: var(--space-xl); }
  .shop-cs-actions { display: flex; gap: var(--space-lg); justify-content: center; flex-wrap: wrap; }
</style>
