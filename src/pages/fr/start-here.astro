---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Par Où Commencer | Votre Feuille de Route Afrique - Sankofa Expeditions';
const description = 'Nouveau sur Sankofa Expeditions ? Voici votre point de départ. Découvrez qui nous sommes, ce que nous faisons, et trouvez la bonne voie pour votre relocalisation, patrimoine, business ou investissement en Afrique.';

const paths = [
  {
    emoji: '🏠',
    headline: 'Je veux me relocaliser en Afrique',
    description: "Vous envisagez un déménagement permanent ou semi-permanent sur le continent. Vous avez besoin d'intelligence réelle sur les visas, le coût de la vie, le logement, la santé, les banques et la communauté.",
    links: [
      { label: 'Visas Nomades et Relocalisation', href: '/directories/nomad-visas' },
      { label: 'Citoyenneté par Filiation et Investissement', href: '/directories/citizenship' },
      { label: 'Contacts d\'Urgence par Pays', href: '/directories/emergency-contacts' },
      { label: 'Demander un Brief Relocalisation', href: '/services' },
    ],
    cta: { label: 'Explorer l\'Intel Relocalisation', href: '/travel/relocation' },
  },
  {
    emoji: '🌍',
    headline: 'Je veux renouer avec mon patrimoine',
    description: "Vous êtes prêt à fouler la terre de vos ancêtres. Résultats ADN, noms de famille, ou un appel profond vers le continent. Nous vous accompagnons de la curiosité à la connexion significative.",
    links: [
      { label: 'Voyages Patrimoine et Racines', href: '/travel/heritage' },
      { label: 'Aperçu des Expéditions', href: '/expeditions' },
      { label: 'Réserver une Consultation Gratuite', href: '/consult' },
    ],
    cta: { label: 'Explorer les Voyages Patrimoine', href: '/travel/heritage' },
  },
  {
    emoji: '📊',
    headline: 'Je veux construire ou investir en Afrique',
    description: "Vous voyez l'opportunité. Vous avez besoin d'intel terrain avant de déployer capital ou temps. Études de marché, vérification de partenaires, cartographie réglementaire et reconnaissance business sur tout le continent.",
    links: [
      { label: 'Reconnaissance Business', href: '/travel/business' },
      { label: 'Prospection d\'Investissement', href: '/travel/investment' },
      { label: 'Économies Circulaires Bitcoin', href: '/directories/bitcoin-circular-economies' },
      { label: 'Demander un Package Recon', href: '/services' },
    ],
    cta: { label: 'Explorer l\'Intel Business', href: '/travel/business' },
  },
  {
    emoji: '👥',
    headline: 'Je veux amener un groupe',
    description: "Vous organisez un voyage de groupe, une délégation diaspora, un groupe religieux ou une réunion de famille. Nous gérons la logistique, l'intelligence et la coordination terrain pour que vous puissiez vous concentrer sur l'expérience.",
    links: [
      { label: 'Expéditions de Groupe', href: '/travel/groups' },
      { label: 'Obtenir une Proposition de Groupe', href: '/contact' },
    ],
    cta: { label: 'Planifier une Expédition de Groupe', href: '/travel/groups' },
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://sankofaexpeditions.com/fr/start-here#webpage",
    "url": "https://sankofaexpeditions.com/fr/start-here",
    "name": title,
    "description": description,
    "isPartOf": { "@id": "https://sankofaexpeditions.com/#website" },
    "about": { "@id": "https://sankofaexpeditions.com/#organization" },
    "inLanguage": "fr-FR",
    "datePublished": "2024-01-01",
    "dateModified": new Date().toISOString().split('T')[0]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL="https://sankofaexpeditions.com/fr/start-here"
  jsonLd={jsonLd}
>

  <section class="sh-hero" aria-labelledby="sh-hero-heading">
    <div class="container sh-hero-inner">
      <span class="eyebrow">Nouveau Ici ?</span>
      <h1 id="sh-hero-heading">Par Où Commencer</h1>
      <p class="sh-hero-desc">
        Vous nous avez trouvés. Maintenant, voyons où vous allez.
        Sankofa Expeditions est une société d'intelligence et d'expédition pour la diaspora africaine.
        Choisissez votre parcours ci-dessous et nous vous dirigerons vers exactement ce dont vous avez besoin.
      </p>
      <nav class="sh-hero-breadcrumb" aria-label="Fil d'Ariane">
        <ol>
          <li><a href="/fr">Accueil</a></li>
          <li aria-current="page">Par Où Commencer</li>
        </ol>
      </nav>
    </div>
  </section>

  <section class="section sh-what" aria-labelledby="sh-what-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Qui Nous Sommes</span>
        <h2 id="sh-what-heading">Intelligence pour la Diaspora Africaine</h2>
        <p>Nous recherchons, vérifions et livrons des informations exploitables pour que vous puissiez vous déplacer, construire et investir en Afrique subsaharienne en toute confiance.</p>
      </div>
      <div class="sh-pillars">
        <div class="sh-pillar card">
          <div class="sh-pillar-icon" aria-hidden="true">🔍</div>
          <h3>Recherche sur le Terrain</h3>
          <p>De vraies sources dans de vrais endroits. Pas des articles de blog recyclés. Intelligence vérifiée depuis des réseaux locaux à travers 54 nations.</p>
        </div>
        <div class="sh-pillar card">
          <div class="sh-pillar-icon" aria-hidden="true">📋</div>
          <h3>Répertoires Gratuits</h3>
          <p>Données en accès libre sur les visas nomades, les voies de citoyenneté, les contacts d'urgence et les écosystèmes Bitcoin. Utilisez-les maintenant, sans inscription.</p>
        </div>
        <div class="sh-pillar card">
          <div class="sh-pillar-icon" aria-hidden="true">🧭</div>
          <h3>Intelligence Personnalisée</h3>
          <p>Briefs de recherche et planification d'expéditions sur mesure pour la relocalisation, le patrimoine, les affaires et l'investissement sur le continent.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt sh-paths" aria-labelledby="sh-paths-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Trouvez Votre Parcours</span>
        <h2 id="sh-paths-heading">Qu'est-ce qui Vous Amène Ici ?</h2>
        <p>Dites-nous votre objectif et nous vous dirigerons vers les bonnes ressources.</p>
      </div>
      <div class="sh-path-grid">
        {paths.map((path) => (
          <article class="sh-path-card card">
            <div class="sh-path-emoji" aria-hidden="true">{path.emoji}</div>
            <h3 class="sh-path-headline">{path.headline}</h3>
            <p class="sh-path-desc">{path.description}</p>
            <ul class="sh-path-links" role="list">
              {path.links.map(link => (
                <li>
                  <a href={link.href}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
            <a href={path.cta.href} class="btn btn--primary sh-path-cta">{path.cta.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark sh-resources" aria-labelledby="sh-resources-heading">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Intel Gratuit, Maintenant</span>
        <h2 id="sh-resources-heading">Commencez avec Nos Répertoires Ouverts</h2>
        <p>Sans inscription. Sans payant. Des données réelles, mises à jour régulièrement.</p>
      </div>
      <div class="sh-resource-grid">
        <a href="/directories/nomad-visas" class="sh-resource-card">
          <span class="sh-resource-icon" aria-hidden="true">🛂</span>
          <h3>Répertoire Visas Nomades</h3>
          <p>Exigences, durée, coût et éligibilité pour 6 pays africains qui accueillent activement les travailleurs à distance et les membres de la diaspora.</p>
          <span class="sh-resource-link">Explorer les visas →</span>
        </a>
        <a href="/directories/citizenship" class="sh-resource-card">
          <span class="sh-resource-icon" aria-hidden="true">🪪</span>
          <h3>Répertoire Citoyenneté</h3>
          <p>Voies de citoyenneté par filiation, naturalisation et investissement dans 11 nations africaines. Connaissez vos droits avant d'atterrir.</p>
          <span class="sh-resource-link">Explorer la citoyenneté →</span>
        </a>
        <a href="/directories/emergency-contacts" class="sh-resource-card">
          <span class="sh-resource-icon" aria-hidden="true">📞</span>
          <h3>Contacts d'Urgence</h3>
          <p>Numéros d'urgence vérifiés, contacts de l'ambassade américaine et services médicaux pour le Ghana, le Kenya, le Nigeria, le Rwanda et l'Afrique du Sud.</p>
          <span class="sh-resource-link">Explorer les contacts →</span>
        </a>
        <a href="/directories/bitcoin-circular-economies" class="sh-resource-card">
          <span class="sh-resource-icon" aria-hidden="true">₿</span>
          <h3>Économies Circulaires Bitcoin</h3>
          <p>Là où le Bitcoin est de la vraie monnaie en Afrique. Commerçants, services et communautés fonctionnant avec une monnaie saine sur tout le continent.</p>
          <span class="sh-resource-link">Explorer Bitcoin →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--dark sh-cta-section" aria-labelledby="sh-cta-heading">
    <div class="container text-center">
      <span class="eyebrow">Prêt ?</span>
      <h2 id="sh-cta-heading">Parlons de Votre Destination</h2>
      <hr class="divider" />
      <p class="sh-cta-desc">
        Réservez une consultation gratuite de 30 minutes. Pas de vente. Pas d'obligation.
        Juste une conversation directe sur votre objectif Afrique et l'intelligence dont vous avez besoin pour l'exécuter.
      </p>
      <div class="sh-cta-actions">
        <a href="https://calendly.com/expeditsankofa/30min" target="_blank" rel="noopener" class="btn btn--primary">
          Réserver une Consultation Gratuite
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/services" class="btn btn--secondary">Voir les Services et Tarifs</a>
      </div>
      <p class="sh-cta-newsletter">
        Pas encore prêt à parler ? <a href="https://sankofa-expeditions.beehiiv.com/subscribe" target="_blank" rel="noopener">Abonnez-vous à notre newsletter d'intel hebdomadaire</a> et obtenez d'abord un aperçu de la situation.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .sh-hero {
    background: var(--color-dark);
    color: var(--color-text-on-dark);
    padding: var(--space-3xl) 0;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .sh-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
      radial-gradient(ellipse at 20% 60%, rgba(196, 132, 29, 0.07) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 30%, rgba(196, 132, 29, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }
  .sh-hero-inner { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; }
  .sh-hero h1 { color: var(--color-text-light); margin-bottom: var(--space-lg); }
  .sh-hero-desc { font-size: 1.1rem; color: var(--color-text-on-dark); opacity: 0.85; max-width: 600px; margin: 0 auto var(--space-xl); line-height: 1.7; }
  .sh-hero-breadcrumb ol { display: flex; justify-content: center; align-items: center; gap: var(--space-sm); list-style: none; padding: 0; margin: 0; font-size: 0.85rem; }
  .sh-hero-breadcrumb li { display: flex; align-items: center; gap: var(--space-sm); color: var(--color-text-on-dark); opacity: 0.6; }
  .sh-hero-breadcrumb li + li::before { content: '→'; color: var(--color-gold); opacity: 0.5; }
  .sh-hero-breadcrumb a { color: var(--color-gold-light); text-decoration: none; opacity: 1; }
  .sh-hero-breadcrumb a:hover { color: var(--color-gold); text-decoration: underline; }
  .sh-pillars { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }
  @media (min-width: 768px) { .sh-pillars { grid-template-columns: repeat(3, 1fr); } }
  .sh-pillar { text-align: center; padding: var(--space-2xl); }
  .sh-pillar-icon { font-size: 2.5rem; margin-bottom: var(--space-lg); display: block; }
  .sh-pillar h3 { font-size: 1.1rem; margin-bottom: var(--space-md); }
  .sh-path-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-xl); }
  @media (min-width: 768px) { .sh-path-grid { grid-template-columns: repeat(2, 1fr); } }
  .sh-path-card { display: flex; flex-direction: column; padding: var(--space-2xl); }
  .sh-path-emoji { font-size: 2rem; margin-bottom: var(--space-md); }
  .sh-path-headline { font-size: 1.2rem; margin-bottom: var(--space-md); color: var(--color-dark); }
  .sh-path-desc { color: var(--color-text-muted); line-height: 1.65; margin-bottom: var(--space-lg); flex: 1; }
  .sh-path-links { list-style: none; padding: 0; margin: 0 0 var(--space-xl) 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .sh-path-links a { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--color-dark); text-decoration: none; font-weight: 500; }
  .sh-path-links a:hover { color: var(--color-gold); text-decoration: underline; }
  .sh-path-links svg { flex-shrink: 0; color: var(--color-gold); }
  .sh-path-cta { margin-top: auto; align-self: flex-start; }
  .sh-resource-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 640px) { .sh-resource-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sh-resource-grid { grid-template-columns: repeat(4, 1fr); } }
  .sh-resource-card { display: flex; flex-direction: column; padding: var(--space-xl); text-decoration: none; color: var(--color-text-on-dark); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-lg); background: rgba(255,255,255,0.04); transition: all var(--transition-base); }
  .sh-resource-card:hover { background: rgba(255,255,255,0.07); border-color: rgba(196, 132, 29, 0.3); transform: translateY(-2px); }
  .sh-resource-icon { font-size: 1.8rem; margin-bottom: var(--space-md); }
  .sh-resource-card h3 { font-size: 1rem; color: var(--color-text-light); margin-bottom: var(--space-sm); }
  .sh-resource-card p { font-size: 0.875rem; color: var(--color-text-on-dark); opacity: 0.75; line-height: 1.6; flex: 1; margin-bottom: var(--space-lg); }
  .sh-resource-link { font-size: 0.85rem; color: var(--color-gold-light); font-weight: 600; margin-top: auto; }
  .sh-cta-section { text-align: center; }
  .sh-cta-desc { font-size: 1.1rem; color: var(--color-text-on-dark); opacity: 0.85; max-width: 560px; margin: 0 auto var(--space-2xl); line-height: 1.7; }
  .sh-cta-actions { display: flex; gap: var(--space-lg); justify-content: center; flex-wrap: wrap; margin-bottom: var(--space-xl); }
  .sh-cta-newsletter { font-size: 0.9rem; color: var(--color-text-on-dark); opacity: 0.65; }
  .sh-cta-newsletter a { color: var(--color-gold-light); text-decoration: underline; }
</style>
