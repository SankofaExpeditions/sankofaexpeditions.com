---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const dataDir = join(process.cwd(), 'src/data/directories/citizenship');
  const files = readdirSync(dataDir).filter(f => f.endsWith('.json'));
  return files.map(f => ({ params: { country: f.replace('.json', '') } }));
}

const { country: countrySlug } = Astro.params;
const dataDir = join(process.cwd(), 'src/data/directories/citizenship');
const data = JSON.parse(readFileSync(join(dataDir, `${countrySlug}.json`), 'utf-8'));

const { country, countryCode, flag, region, citizenship, keyFacts, whyItMatters, lastUpdated } = data;
const { dualCitizenshipPermitted, dualCitizenshipNote, diasporaProgram } = citizenship;

const statusLabel: Record<string, string> = {
  'active': 'Program Active',
  'active-with-disruptions': 'Active, Disruptions Reported',
  'active-with-restrictions': 'Active with Restrictions',
  'restricted': 'Restricted',
};

const title = `${country} Dual Citizenship for Diaspora ${new Date().getFullYear()} | Eligibility & Process | Sankofa Expeditions`;
const description = data.summary.length > 155 ? data.summary.substring(0, 152) + '...' : data.summary;

const pageUrl = `https://sankofaexpeditions.com/directories/citizenship/${countrySlug}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}/#webpage`,
    "url": pageUrl,
    "name": title,
    "description": description,
    "isPartOf": { "@id": "https://sankofaexpeditions.com/#website" },
    "breadcrumb": { "@id": `${pageUrl}/#breadcrumb` },
    "inLanguage": "en-US",
    "dateModified": lastUpdated
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}/#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sankofaexpeditions.com" },
      { "@type": "ListItem", "position": 2, "name": "Directories", "item": "https://sankofaexpeditions.com/directories" },
      { "@type": "ListItem", "position": 3, "name": "Citizenship Tracker", "item": "https://sankofaexpeditions.com/directories/citizenship" },
      { "@type": "ListItem", "position": 4, "name": country, "item": pageUrl }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `Does ${country} allow dual citizenship?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": dualCitizenshipNote
        }
      },
      {
        "@type": "Question",
        "name": `Who is eligible for ${country} citizenship by descent?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": diasporaProgram.eligibility
        }
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/directories">Directories</a>
        <span aria-hidden="true"> / </span>
        <a href="/directories/citizenship">Citizenship Tracker</a>
        <span aria-hidden="true"> / </span>
        <span>{country}</span>
      </nav>
      <div class="hero-flag" aria-hidden="true">{flag}</div>
      <p class="eyebrow">{region}</p>
      <h1>{country} Dual Citizenship</h1>
      <p class="hero-sub">{data.summary}</p>
      <div class="dual-status">
        <div class={`dual-pill dual-pill--${dualCitizenshipPermitted ? 'yes' : 'no'}`}>
          {dualCitizenshipPermitted ? 'Dual Citizenship Permitted' : 'Dual Citizenship Restricted'}
        </div>
        <div class={`program-status program-status--${diasporaProgram.status}`}>
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-text">{statusLabel[diasporaProgram.status] ?? diasporaProgram.status}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section legal-section">
    <div class="container container--narrow">
      <h2>Legal Framework</h2>
      <p class="legal-note">{dualCitizenshipNote}</p>

      {diasporaProgram.statusNote && (
        <div class="alert alert--info">
          <strong>Current Status:</strong> {diasporaProgram.statusNote}
        </div>
      )}
    </div>
  </section>

  <section class="section program-section">
    <div class="container container--narrow">
      <h2>{diasporaProgram.name}</h2>

      <div class="details-grid">
        <div class="detail-row">
          <span class="detail-label">Eligibility</span>
          <span class="detail-value">{diasporaProgram.eligibility}</span>
        </div>

        {diasporaProgram.applicationFeeNote && (
          <div class="detail-row">
            <span class="detail-label">Application Fee</span>
            <span class="detail-value">{diasporaProgram.applicationFeeNote}</span>
          </div>
        )}
      </div>

      {diasporaProgram.keyDocuments && diasporaProgram.keyDocuments.length > 0 && (
        <div class="docs-section">
          <h3>Key Documents Required</h3>
          <ul class="docs-list">
            {diasporaProgram.keyDocuments.map((doc: string) => (
              <li>{doc}</li>
            ))}
          </ul>
        </div>
      )}

      {diasporaProgram.processSteps && diasporaProgram.processSteps.length > 0 && (
        <div class="steps-section">
          <h3>Process Steps</h3>
          <ol class="steps-list">
            {diasporaProgram.processSteps.map((step: string) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      )}

      <div class="official-links">
        {diasporaProgram.officialUrl && (
          <a href={diasporaProgram.officialUrl} target="_blank" rel="noopener noreferrer" class="official-link">
            Official Immigration Portal &rarr;
          </a>
        )}
        {diasporaProgram.embassyUrl && (
          <a href={diasporaProgram.embassyUrl} target="_blank" rel="noopener noreferrer" class="official-link official-link--secondary">
            Embassy (USA) &rarr;
          </a>
        )}
      </div>
    </div>
  </section>

  {keyFacts && keyFacts.length > 0 && (
    <section class="section facts-section">
      <div class="container container--narrow">
        <h2>Key Facts</h2>
        <ul class="facts-list">
          {keyFacts.map((fact: string) => (
            <li>{fact}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {whyItMatters && (
    <section class="section context-section">
      <div class="container container--narrow">
        <h2>Why {country}</h2>
        <p>{whyItMatters}</p>
      </div>
    </section>
  )}

  <section class="section legal-disclaimer">
    <div class="container container--narrow">
      <h3>Important Disclaimer</h3>
      <p>This page is informational only and does not constitute legal advice. Citizenship law changes. Processing timelines vary. Consult an immigration attorney familiar with {country}'s laws before making any decisions.</p>
      <p class="verification-meta">
        Last verified: {lastUpdated}. Source: {diasporaProgram.verificationNote}
      </p>
      <p class="verification-meta">
        See a discrepancy? <a href="/contact">Let us know</a>.
      </p>
    </div>
  </section>

  {['ghana','kenya','nigeria','rwanda','south-africa'].includes(countrySlug) && (
    <section class="section crosslink-section">
      <div class="container container--narrow">
        <p class="crosslink-text">
          Planning a move to {country}? Save the emergency contacts first.{' '}
          <a href={`/directories/emergency-contacts/${countrySlug}`}>
            {country} emergency numbers, embassies &amp; hospitals &rarr;
          </a>
        </p>
      </div>
    </section>
  )}

  <section class="section nav-section">
    <div class="container">
      <div class="nav-links">
        <a href="/directories/citizenship" class="nav-back">&larr; All Africa Citizenship</a>
        <a href="/directories" class="nav-back">All Directories &rarr;</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .page-hero {
    background: var(--color-dark);
    color: var(--color-text-on-dark);
    padding: var(--space-4xl) 0 var(--space-3xl);
  }

  .breadcrumb {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--space-lg);
    display: flex;
    gap: 6px;
    align-items: center;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-flag {
    font-size: 3rem;
    line-height: 1;
    margin-bottom: var(--space-lg);
  }

  .page-hero .eyebrow {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: var(--space-md);
  }

  .page-hero h1 {
    color: #fff;
    max-width: 25ch;
    margin-bottom: var(--space-lg);
  }

  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.85);
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }

  .dual-status {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    align-items: center;
  }

  .dual-pill {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 14px;
  }

  .dual-pill--yes {
    background: rgba(255,255,255,0.15);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.3);
  }

  .dual-pill--no {
    background: transparent;
    color: rgba(255,255,255,0.7);
    border: 1px solid rgba(255,255,255,0.2);
  }

  .program-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid rgba(255,255,255,0.2);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .program-status--active .status-dot { background: #5eff9c; }
  .program-status--active-with-disruptions .status-dot { background: rgba(255,220,80,0.9); }
  .program-status--active-with-restrictions .status-dot { background: rgba(255,180,50,0.9); }
  .program-status--restricted .status-dot { background: rgba(255,255,255,0.3); }

  .status-text {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.9);
  }

  /* Shared */
  .container--narrow {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
  }

  /* Legal */
  .legal-section {
    background: var(--color-bg);
  }

  .legal-section h2 {
    margin-bottom: var(--space-xl);
  }

  .legal-note {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .alert {
    padding: var(--space-lg);
    border-left: 3px solid var(--color-border);
    background: var(--color-bg-alt);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .alert--info {
    border-color: var(--color-text-muted);
  }

  .alert strong {
    color: var(--color-text);
  }

  /* Program */
  .program-section {
    background: var(--color-bg-alt);
  }

  .program-section h2 {
    margin-bottom: var(--space-xl);
  }

  .program-section h3 {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: var(--space-2xl) 0 var(--space-lg);
  }

  .details-grid {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    margin-bottom: var(--space-2xl);
  }

  .detail-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-md);
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }

  .detail-row:last-child {
    border-bottom: none;
  }

  .detail-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    padding-top: 2px;
  }

  .detail-value {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .docs-list,
  .steps-list {
    padding: 0 0 0 var(--space-xl);
    margin: 0 0 var(--space-xl) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .docs-list li,
  .steps-list li {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    padding-left: var(--space-sm);
  }

  .official-links {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }

  .official-link {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    padding: 10px 20px;
    background: var(--color-dark);
    color: #fff;
  }

  .official-link:hover {
    opacity: 0.85;
  }

  .official-link--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  /* Facts */
  .facts-section {
    background: var(--color-bg);
  }

  .facts-section h2 {
    margin-bottom: var(--space-xl);
  }

  .facts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .facts-list li {
    padding-left: var(--space-lg);
    position: relative;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .facts-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  /* Context */
  .context-section {
    background: var(--color-bg-alt);
  }

  .context-section h2 {
    margin-bottom: var(--space-xl);
  }

  .context-section p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  /* Disclaimer */
  .legal-disclaimer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .legal-disclaimer h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    font-weight: 700;
  }

  .legal-disclaimer p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .verification-meta {
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .verification-meta a {
    color: var(--color-text);
  }

  /* Crosslink */
  .crosslink-section {
    background: var(--color-bg-alt);
    padding-top: 0;
  }

  .crosslink-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    margin: 0;
    line-height: 1.65;
  }

  .crosslink-text a {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Nav */
  .nav-section {
    background: var(--color-bg-alt);
    padding: var(--space-xl) 0;
  }

  .nav-links {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .nav-back {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-back:hover {
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .detail-row {
      grid-template-columns: 1fr;
    }
  }
</style>
