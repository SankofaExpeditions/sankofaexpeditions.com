---
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const dataDir = join(process.cwd(), 'src/data/directories/nomad-cities');
  const files = readdirSync(dataDir).filter(f => f.endsWith('.json'));
  return files.map(f => ({ params: { city: f.replace('.json', '') } }));
}

const { city: citySlug } = Astro.params;
const dataDir = join(process.cwd(), 'src/data/directories/nomad-cities');
const data = JSON.parse(readFileSync(join(dataDir, `${citySlug}.json`), 'utf-8'));

const {
  city, country, flag, region, timezone, language, currency,
  summary, lastUpdated, overallScore, scores, costOfLiving,
  internet, safety, weather, coworking, visaEase, expatCommunity,
  keyFacts, whyItMatters, highlights, challenges, nomadRating
} = data;

const title = `${city} for Digital Nomads and Diaspora Returnees | Sankofa Expeditions`;
const description = `${city} nomad guide: cost of living, internet speeds, safety, visa info, coworking spaces, and what the diaspora needs to know. Updated ${lastUpdated}.`.slice(0, 155);

const ratingColor: Record<string, string> = {
  excellent: '#22c55e',
  good: '#3b82f6',
  advanced: '#f59e0b',
};
const ratingLabel: Record<string, string> = {
  excellent: 'Excellent for Nomads',
  good: 'Good for Nomads',
  advanced: 'Advanced Users',
};

const scoreBar = (val: number) => `${val}%`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `https://sankofaexpeditions.com/directories/nomad-cities/${citySlug}`,
      "url": `https://sankofaexpeditions.com/directories/nomad-cities/${citySlug}`,
      "name": title,
      "description": description,
      "dateModified": lastUpdated,
      "breadcrumb": { "@id": `https://sankofaexpeditions.com/directories/nomad-cities/${citySlug}#breadcrumb` },
      "isPartOf": { "@id": "https://sankofaexpeditions.com" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://sankofaexpeditions.com/directories/nomad-cities/${citySlug}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sankofaexpeditions.com" },
        { "@type": "ListItem", "position": 2, "name": "Directories", "item": "https://sankofaexpeditions.com/directories" },
        { "@type": "ListItem", "position": 3, "name": "Nomad Cities for Africa", "item": "https://sankofaexpeditions.com/directories/nomad-cities" },
        { "@type": "ListItem", "position": 4, "name": city, "item": `https://sankofaexpeditions.com/directories/nomad-cities/${citySlug}` }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `How much does it cost to live in ${city} as a digital nomad?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `A digital nomad in ${city} should budget $${costOfLiving.monthlyBudgetUSD.min} to $${costOfLiving.monthlyBudgetUSD.max} per month. A one-bedroom apartment in the city center costs $${costOfLiving.rentOneBRCentralUSD.min} to $${costOfLiving.rentOneBRCentralUSD.max}/month. Coworking spaces range from $${costOfLiving.coworkingMonthUSD.min} to $${costOfLiving.coworkingMonthUSD.max}/month.`
          }
        },
        {
          "@type": "Question",
          "name": `Is ${city} safe for foreigners and diaspora returnees?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The US State Department rates ${country} at Level ${safety.usDeptStateLevel} (${safety.usDeptStateLevelLabel}). ${safety.keyNotes}`
          }
        },
        {
          "@type": "Question",
          "name": `Do US, UK, or Canadian citizens need a visa for ${city}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `US passport: ${visaEase.usPassport} UK passport: ${visaEase.ukPassport} Canadian passport: ${visaEase.caPassport}${visaEase.specialNote ? ' ' + visaEase.specialNote : ''}`
          }
        },
        {
          "@type": "Question",
          "name": `How is the internet in ${city} for remote work?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Fixed broadband speeds in ${city} average ${internet.fixedBroadbandMbps.min} to ${internet.fixedBroadbandMbps.max} Mbps. Mobile connectivity: ${internet.mobileQuality}. ${internet.reliabilityNotes}`
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main class="city-page">

    <!-- Hero -->
    <section class="city-hero">
      <div class="container container--narrow">
        <div class="city-hero__breadcrumb">
          <a href="/">Home</a> <span>/</span>
          <a href="/directories">Directories</a> <span>/</span>
          <a href="/directories/nomad-cities">Nomad Cities</a> <span>/</span>
          <span>{city}</span>
        </div>
        <div class="city-hero__header">
          <span class="city-hero__flag">{flag}</span>
          <div>
            <h1 class="city-hero__title">{city}, {country}</h1>
            <p class="city-hero__meta">{region} &middot; {timezone} &middot; {language}</p>
          </div>
          <div class="city-hero__score">
            <span class="city-hero__score-number">{overallScore}</span>
            <span class="city-hero__score-label">/ 100</span>
          </div>
        </div>
        <p class="city-hero__summary">{summary}</p>
        <div class="city-hero__badges">
          <span class="badge badge--rating" style={`background: ${ratingColor[nomadRating] || '#6b7280'}22; color: ${ratingColor[nomadRating] || '#6b7280'}; border-color: ${ratingColor[nomadRating] || '#6b7280'}44`}>
            {ratingLabel[nomadRating] || nomadRating}
          </span>
          {visaEase.nomadVisaExists && <span class="badge badge--nomad-visa">Nomad Visa Available</span>}
        </div>
      </div>
    </section>

    <!-- Score Cards -->
    <section class="section section--light">
      <div class="container container--narrow">
        <h2 class="section-title">At a Glance</h2>
        <div class="score-grid">
          {[
            { label: 'Cost of Living', key: 'costOfLiving', icon: '💰' },
            { label: 'Internet', key: 'internet', icon: '📶' },
            { label: 'Safety', key: 'safety', icon: '🛡️' },
            { label: 'Weather', key: 'weather', icon: '☀️' },
            { label: 'Visa Ease', key: 'visaEase', icon: '🛂' },
            { label: 'Expat Community', key: 'expatCommunity', icon: '👥' },
            { label: 'Nomad Infra', key: 'nomadInfra', icon: '🖥️' },
          ].map(({ label, key, icon }) => (
            <div class="score-card">
              <span class="score-card__icon">{icon}</span>
              <span class="score-card__label">{label}</span>
              <div class="score-card__bar-track">
                <div class="score-card__bar-fill" style={`width: ${scoreBar(scores[key as keyof typeof scores])}`}></div>
              </div>
              <span class="score-card__value">{scores[key as keyof typeof scores]}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Cost of Living -->
    <section class="section">
      <div class="container container--narrow">
        <h2 class="section-title">Cost of Living</h2>
        <div class="data-grid">
          <div class="data-card">
            <span class="data-card__label">Monthly Budget</span>
            <span class="data-card__value">${costOfLiving.monthlyBudgetUSD.min} &ndash; ${costOfLiving.monthlyBudgetUSD.max}</span>
            <span class="data-card__unit">USD / month</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">1BR Apartment (central)</span>
            <span class="data-card__value">${costOfLiving.rentOneBRCentralUSD.min} &ndash; ${costOfLiving.rentOneBRCentralUSD.max}</span>
            <span class="data-card__unit">USD / month</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">Local Restaurant Meal</span>
            <span class="data-card__value">${costOfLiving.localMealUSD}</span>
            <span class="data-card__unit">USD</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">Coworking (hot desk)</span>
            <span class="data-card__value">${costOfLiving.coworkingMonthUSD.min} &ndash; ${costOfLiving.coworkingMonthUSD.max}</span>
            <span class="data-card__unit">USD / month</span>
          </div>
        </div>
        {costOfLiving.currencyNote && <p class="section-note">{costOfLiving.currencyNote}</p>}
        <p class="data-source">Source: {costOfLiving.source}</p>
      </div>
    </section>

    <!-- Internet & Connectivity -->
    <section class="section section--light">
      <div class="container container--narrow">
        <h2 class="section-title">Internet and Connectivity</h2>
        <div class="data-grid">
          <div class="data-card">
            <span class="data-card__label">Fixed Broadband</span>
            <span class="data-card__value">{internet.fixedBroadbandMbps.min} &ndash; {internet.fixedBroadbandMbps.max}</span>
            <span class="data-card__unit">Mbps avg</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">Mobile Quality</span>
            <span class="data-card__value data-card__value--sm">{internet.mobileQuality}</span>
          </div>
        </div>
        <p class="section-note">{internet.reliabilityNotes}</p>
        <p class="data-label">Main Providers:</p>
        <div class="tag-list">
          {internet.mainProviders.map((p: string) => <span class="tag">{p}</span>)}
        </div>
      </div>
    </section>

    <!-- Safety -->
    <section class="section">
      <div class="container container--narrow">
        <h2 class="section-title">Safety</h2>
        <div class="data-grid">
          <div class="data-card">
            <span class="data-card__label">Numbeo Safety Index</span>
            <span class="data-card__value">{safety.numbeoSafetyIndex}</span>
            <span class="data-card__unit">/ 100 (higher = safer)</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">US State Dept Level</span>
            <span class="data-card__value">{safety.usDeptStateLevel}</span>
            <span class="data-card__unit">{safety.usDeptStateLevelLabel}</span>
          </div>
        </div>
        <p class="section-note">{safety.keyNotes}</p>
        {safety.safeNeighborhoods.length > 0 && (
          <>
            <p class="data-label">Recommended Neighborhoods:</p>
            <div class="tag-list">
              {safety.safeNeighborhoods.map((n: string) => <span class="tag tag--safe">{n}</span>)}
            </div>
          </>
        )}
        {safety.cautionAreas.length > 0 && (
          <>
            <p class="data-label">Exercise Caution:</p>
            <div class="tag-list">
              {safety.cautionAreas.map((n: string) => <span class="tag tag--caution">{n}</span>)}
            </div>
          </>
        )}
      </div>
    </section>

    <!-- Weather -->
    <section class="section section--light">
      <div class="container container--narrow">
        <h2 class="section-title">Weather and Climate</h2>
        <div class="data-grid">
          <div class="data-card">
            <span class="data-card__label">Temperature Range</span>
            <span class="data-card__value">{weather.tempRangeCelsius.min}&deg; &ndash; {weather.tempRangeCelsius.max}&deg;C</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">Best Months to Visit</span>
            <span class="data-card__value data-card__value--sm">{weather.bestMonthsToVisit}</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">Dry Season</span>
            <span class="data-card__value data-card__value--sm">{weather.drySeasonMonths}</span>
          </div>
          <div class="data-card">
            <span class="data-card__label">Rainy Season</span>
            <span class="data-card__value data-card__value--sm">{weather.rainySeasonMonths}</span>
          </div>
        </div>
        <p class="section-note">{weather.climateNotes}</p>
      </div>
    </section>

    <!-- Visa -->
    <section class="section">
      <div class="container container--narrow">
        <h2 class="section-title">Visa Requirements</h2>
        <div class="visa-cards">
          <div class="visa-card">
            <span class="visa-card__passport">🇺🇸 US Passport</span>
            <p class="visa-card__info">{visaEase.usPassport}</p>
          </div>
          <div class="visa-card">
            <span class="visa-card__passport">🇬🇧 UK Passport</span>
            <p class="visa-card__info">{visaEase.ukPassport}</p>
          </div>
          <div class="visa-card">
            <span class="visa-card__passport">🇨🇦 Canadian Passport</span>
            <p class="visa-card__info">{visaEase.caPassport}</p>
          </div>
        </div>
        {visaEase.specialNote && <p class="section-note section-note--highlight">{visaEase.specialNote}</p>}
        {visaEase.nomadVisaExists && visaEase.nomadVisaNote && (
          <div class="nomad-visa-box">
            <span class="nomad-visa-box__label">Digital Nomad Visa</span>
            <p>{visaEase.nomadVisaNote}</p>
            {visaEase.visaSourceUrl && <a href={visaEase.visaSourceUrl} target="_blank" rel="noopener noreferrer" class="link-external">Official Application &rarr;</a>}
          </div>
        )}
        {!visaEase.nomadVisaExists && (
          <p class="section-note">{visaEase.nomadVisaNote}</p>
        )}
        {!visaEase.nomadVisaExists && visaEase.visaSourceUrl && (
          <a href={visaEase.visaSourceUrl} target="_blank" rel="noopener noreferrer" class="link-external">Official Immigration Portal &rarr;</a>
        )}
      </div>
    </section>

    <!-- Coworking -->
    <section class="section section--light">
      <div class="container container--narrow">
        <h2 class="section-title">Coworking Spaces</h2>
        <div class="cowork-list">
          {coworking.map((space: { name: string; neighborhood: string }) => (
            <div class="cowork-item">
              <span class="cowork-item__name">{space.name}</span>
              <span class="cowork-item__neighborhood">{space.neighborhood}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Key Facts -->
    <section class="section">
      <div class="container container--narrow">
        <h2 class="section-title">Key Facts for Nomads and Diaspora</h2>
        <ul class="facts-list">
          {keyFacts.map((fact: string) => (
            <li class="facts-list__item">{fact}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Why It Matters -->
    <section class="section section--dark">
      <div class="container container--narrow">
        <h2 class="section-title section-title--light">Why {city} for the Diaspora</h2>
        <p class="why-text">{whyItMatters}</p>
      </div>
    </section>

    <!-- Highlights vs Challenges -->
    <section class="section">
      <div class="container container--narrow">
        <div class="hc-grid">
          <div class="hc-col">
            <h3 class="hc-col__title hc-col__title--pro">Highlights</h3>
            <ul class="hc-list">
              {highlights.map((h: string) => <li class="hc-list__item hc-list__item--pro">{h}</li>)}
            </ul>
          </div>
          <div class="hc-col">
            <h3 class="hc-col__title hc-col__title--con">Challenges</h3>
            <ul class="hc-list">
              {challenges.map((c: string) => <li class="hc-list__item hc-list__item--con">{c}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Expat Community -->
    <section class="section section--light">
      <div class="container container--narrow">
        <h2 class="section-title">Expat and Diaspora Community</h2>
        <p class="section-note"><strong>Estimated size:</strong> {expatCommunity.estimatedSize}</p>
        <p class="data-label">Key Hubs:</p>
        <div class="tag-list">
          {expatCommunity.keyHubs.map((h: string) => <span class="tag">{h}</span>)}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section section--cta">
      <div class="container container--narrow">
        <h2 class="cta-title">Planning a move to {city}?</h2>
        <p class="cta-body">Sankofa Expeditions builds personalized relocation plans for the diaspora. From visa strategy to neighborhood selection to financial planning, we know what it actually takes.</p>
        <div class="cta-actions">
          <a href="/consult" class="btn btn--primary">Book a Free Consultation</a>
          <a href="/directories/nomad-cities" class="btn btn--ghost">Compare All 8 Cities</a>
        </div>
        <p class="data-source">Last updated: {lastUpdated}. Data sources: {data.dataSource}. Live API integrations in progress.</p>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
/* City Page Layout */
.city-page { background: #FAFAFA; }

/* Hero */
.city-hero {
  background: #0A0A0A;
  color: #fff;
  padding: 3rem 0 2.5rem;
}
.city-hero__breadcrumb {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.5);
  margin-bottom: 1.5rem;
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  align-items: center;
}
.city-hero__breadcrumb a { color: rgba(255,255,255,0.6); text-decoration: none; }
.city-hero__breadcrumb a:hover { color: #fff; }
.city-hero__header {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  margin-bottom: 1.25rem;
}
.city-hero__flag { font-size: 3rem; line-height: 1; flex-shrink: 0; }
.city-hero__title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 600;
  color: #fff;
  margin: 0 0 0.25rem;
  line-height: 1.1;
}
.city-hero__meta { color: rgba(255,255,255,0.65); font-size: 0.9rem; margin: 0; }
.city-hero__score {
  margin-left: auto;
  text-align: center;
  flex-shrink: 0;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 8px;
  padding: 0.75rem 1rem;
}
.city-hero__score-number {
  display: block;
  font-size: 2rem;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}
.city-hero__score-label { font-size: 0.75rem; color: rgba(255,255,255,0.5); }
.city-hero__summary {
  color: rgba(255,255,255,0.82);
  font-size: 1.05rem;
  line-height: 1.65;
  margin-bottom: 1.25rem;
}
.city-hero__badges { display: flex; gap: 0.6rem; flex-wrap: wrap; }
.badge {
  display: inline-block;
  padding: 0.3rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid;
}
.badge--nomad-visa {
  background: rgba(34,197,94,0.15);
  color: #22c55e;
  border-color: rgba(34,197,94,0.3);
}

/* Sections */
.section { padding: 3rem 0; }
.section--light { background: #fff; }
.section--dark { background: #0A0A0A; color: #fff; }
.section--cta { background: #111; color: #fff; }
.section-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(1.4rem, 3vw, 1.9rem);
  font-weight: 600;
  color: #111;
  margin: 0 0 1.5rem;
}
.section-title--light { color: #fff; }
.section-note {
  color: #555;
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 1rem 0;
}
.section-note--highlight {
  background: #f5f5f5;
  border-left: 3px solid #0A0A0A;
  padding: 0.75rem 1rem;
  border-radius: 0 6px 6px 0;
}
.data-source { font-size: 0.75rem; color: #999; margin-top: 1rem; }
.data-label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #666; margin: 1rem 0 0.5rem; }

/* Score Grid */
.score-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}
.score-card {
  background: #FAFAFA;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.score-card__icon { font-size: 1.25rem; }
.score-card__label { font-size: 0.8rem; color: #666; font-weight: 500; }
.score-card__bar-track {
  height: 6px;
  background: #e5e5e5;
  border-radius: 3px;
  overflow: hidden;
}
.score-card__bar-fill {
  height: 100%;
  background: #0A0A0A;
  border-radius: 3px;
  transition: width 0.3s;
}
.score-card__value { font-size: 0.85rem; font-weight: 700; color: #111; }

/* Data Grid */
.data-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
}
.data-card {
  background: #0A0A0A;
  color: #fff;
  border-radius: 8px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.section--light .data-card { background: #FAFAFA; color: #111; border: 1px solid #e5e5e5; }
.data-card__label { font-size: 0.75rem; color: rgba(255,255,255,0.6); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; }
.section--light .data-card__label { color: #888; }
.data-card__value { font-size: 1.3rem; font-weight: 700; color: #fff; line-height: 1.1; }
.data-card__value--sm { font-size: 0.9rem; font-weight: 600; }
.section--light .data-card__value { color: #111; }
.data-card__unit { font-size: 0.75rem; color: rgba(255,255,255,0.5); }
.section--light .data-card__unit { color: #888; }

/* Tags */
.tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tag {
  display: inline-block;
  padding: 0.3rem 0.7rem;
  background: #f0f0f0;
  color: #333;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 500;
}
.tag--safe { background: rgba(34,197,94,0.1); color: #15803d; }
.tag--caution { background: rgba(234,179,8,0.1); color: #92400e; }

/* Visa Cards */
.visa-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.25rem; }
.visa-card {
  background: #0A0A0A;
  color: #fff;
  border-radius: 8px;
  padding: 1.25rem;
}
.visa-card__passport { font-size: 0.85rem; font-weight: 600; color: rgba(255,255,255,0.7); display: block; margin-bottom: 0.5rem; }
