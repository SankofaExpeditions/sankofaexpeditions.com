---
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const dataDir = join(process.cwd(), 'src/data/directories/safety-intel');
  const files = readdirSync(dataDir).filter(f => f.endsWith('.json'));
  return files.map(f => ({ params: { city: f.replace('.json', '') } }));
}

const { city: citySlug } = Astro.params;
const dataDir = join(process.cwd(), 'src/data/directories/safety-intel');
const data = JSON.parse(readFileSync(join(dataDir, `${citySlug}.json`), 'utf-8'));

const title = `${data.city}, ${data.country} Safety Intelligence | Sankofa Expeditions®`;
const description = `Travel intel for ${data.city}, ${data.country}: safe neighborhoods, practical security tips, US State Dept Level ${data.usDeptState.level} advisory, and emergency contacts. Built for diaspora travelers.`;

const riskColor: Record<string, string> = {
  'low': '#22c55e',
  'low-medium': '#84cc16',
  'medium': '#f59e0b',
  'medium-high': '#f97316',
  'high': '#ef4444',
};

const levelColor: Record<number, string> = {
  1: '#22c55e',
  2: '#f59e0b',
  3: '#f97316',
  4: '#ef4444',
};

const levelLabel: Record<number, string> = {
  1: 'Exercise Normal Precautions',
  2: 'Exercise Increased Caution',
  3: 'Reconsider Travel',
  4: 'Do Not Travel',
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `https://sankofaexpeditions.com/directories/safety-intel/${citySlug}`,
      "url": `https://sankofaexpeditions.com/directories/safety-intel/${citySlug}`,
      "name": title,
      "description": description,
      "breadcrumb": { "@id": `https://sankofaexpeditions.com/directories/safety-intel/${citySlug}#breadcrumb` },
      "isPartOf": { "@id": "https://sankofaexpeditions.com" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://sankofaexpeditions.com/directories/safety-intel/${citySlug}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sankofaexpeditions.com" },
        { "@type": "ListItem", "position": 2, "name": "Directories", "item": "https://sankofaexpeditions.com/directories" },
        { "@type": "ListItem", "position": 3, "name": "Africa Safety Intelligence", "item": "https://sankofaexpeditions.com/directories/safety-intel" },
        { "@type": "ListItem", "position": 4, "name": `${data.city}`, "item": `https://sankofaexpeditions.com/directories/safety-intel/${citySlug}` }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `How do diaspora travelers navigate ${data.city} safely?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${data.city} carries a US State Dept Level ${data.usDeptState.level} advisory (${levelLabel[data.usDeptState.level]}) and a Numbeo Crime Index of ${data.numbeo.crimeIndex}. ${data.summary}`
          }
        },
        {
          "@type": "Question",
          "name": `What are the safest neighborhoods in ${data.city}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The safest neighborhoods in ${data.city} for expats and diaspora visitors are: ${data.safeNeighborhoods.join(', ')}.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the emergency police number in ${data.city}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `The emergency police number in ${data.city}, ${data.country} is ${data.emergencyNumbers.police}. Ambulance: ${data.emergencyNumbers.ambulance}. Fire: ${data.emergencyNumbers.fire}.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the US Embassy contact in ${data.city}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${data.embassyContacts.us.name}. Phone: ${data.embassyContacts.us.phone}. Website: ${data.embassyContacts.us.url}`
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>

  <!-- Hero -->
  <section class="city-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/directories">Directories</a>
        <span>/</span>
        <a href="/directories/safety-intel">Safety Intel</a>
        <span>/</span>
        <span>{data.city}</span>
      </nav>

      <div class="hero-top">
        <span class="city-flag">{data.flag}</span>
        <div>
          <div class="city-region">{data.region} · {data.country}</div>
          <h1>{data.city} Safety Intelligence</h1>
        </div>
      </div>

      <div class="score-row">
        <div class="score-block">
          <div class="score-number" style={`color: ${riskColor[data.overallRisk]}`}>{data.overallSafetyScore}</div>
          <div class="score-label">Safety Score<br/><span class="score-sub">out of 100</span></div>
        </div>
        <div class="score-block">
          <div class="score-number" style={`color: ${levelColor[data.usDeptState.level]}`}>L{data.usDeptState.level}</div>
          <div class="score-label">US State Dept<br/><span class="score-sub">{data.usDeptState.label}</span></div>
        </div>
        <div class="score-block">
          <div class="score-number">{data.numbeo.crimeIndex}</div>
          <div class="score-label">Numbeo Crime<br/><span class="score-sub">higher = more crime</span></div>
        </div>
        <div class="score-block">
          <div class="score-number">{data.numbeo.safetyIndex}</div>
          <div class="score-label">Numbeo Safety<br/><span class="score-sub">higher = safer</span></div>
        </div>
      </div>

      <div class="risk-badge" style={`background: ${riskColor[data.overallRisk]}22; color: ${riskColor[data.overallRisk]}; border-color: ${riskColor[data.overallRisk]}44`}>
        {data.overallRiskLabel}
      </div>

      {data.westernComparisons && data.westernComparisons.length > 0 && (
        <div class="context-comparison">
          <div class="comparison-label">Numbeo Crime Index context</div>
          <div class="comparison-row">
            <div class="comparison-city comparison-city--african">
              <span class="comparison-name">{data.city}</span>
              <span class="comparison-score">{data.numbeo.crimeIndex}</span>
            </div>
            <div class="comparison-vs">vs.</div>
            {data.westernComparisons.map((comp: { city: string; stateOrCountry: string; crimeIndex: number }) => (
              <div class="comparison-city comparison-city--western">
                <span class="comparison-name">{comp.city}, {comp.stateOrCountry}</span>
                <span class="comparison-score">{comp.crimeIndex}</span>
              </div>
            ))}
          </div>
          <p class="comparison-note">Same scoring methodology. Same scale. The question "is Africa safe?" deserves the same scrutiny applied to these cities, which no one hesitates to visit.</p>
        </div>
      )}

      <p class="hero-summary">{data.summary}</p>
    </div>
  </section>

  <!-- Current Alerts -->
  {data.currentAlerts.length > 0 && (
    <section class="alerts-section">
      <div class="container">
        <h2>Current Alerts</h2>
        <div class="alerts-list">
          {data.currentAlerts.map((alert: string) => (
            <div class="alert-item">
              <span class="alert-icon">⚠</span>
              <p>{alert}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Two Column: Safe vs Avoid -->
  <section class="zones-section">
    <div class="container">
      <div class="zones-grid">
        <div class="zone-block zone-safe">
          <h2>Safe Neighborhoods</h2>
          <p class="zone-desc">Established expat and diaspora zones. Standard urban precautions apply.</p>
          <ul>
            {data.safeNeighborhoods.map((n: string) => (
              <li>{n}</li>
            ))}
          </ul>
        </div>
        <div class="zone-block zone-caution">
          <h2>Areas to Avoid</h2>
          <p class="zone-desc">Higher crime rates or specific risk factors. Research before entering.</p>
          <ul>
            {data.cautionAreas.map((n: string) => (
              <li>{n}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Crime Types -->
  <section class="crime-section">
    <div class="container container--narrow">
      <h2>Crime Types</h2>
      <p class="section-intro">Most common incidents affecting expats and diaspora travelers.</p>
      <ul class="crime-list">
        {data.crimeTypes.map((c: string) => (
          <li>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Safety Tips -->
  <section class="tips-section">
    <div class="container container--narrow">
      <h2>Practical Safety Tips</h2>
      <p class="section-intro">City-specific actions that reduce your risk profile.</p>
      <ol class="tips-list">
        {data.safetyTips.map((tip: string) => (
          <li>{tip}</li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Key Facts -->
  <section class="facts-section">
    <div class="container container--narrow">
      <h2>Key Facts</h2>
      <ul class="facts-list">
        {data.keyFacts.map((f: string) => (
          <li>{f}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Official Sources -->
  <section class="sources-section">
    <div class="container">
      <h2>Official Sources</h2>
      <div class="sources-grid">
        <div class="source-card">
          <div class="source-label">US State Department</div>
          <div class="source-level" style={`color: ${levelColor[data.usDeptState.level]}`}>
            Level {data.usDeptState.level}: {data.usDeptState.label}
          </div>
          <p class="source-summary">{data.usDeptState.summary}</p>
          <div class="source-meta">Updated: {data.usDeptState.date}</div>
          <a href={data.usDeptState.url} target="_blank" rel="noopener noreferrer" class="source-link">
            View official advisory →
          </a>
        </div>
        <div class="source-card">
          <div class="source-label">UK Foreign Commonwealth Office</div>
          <p class="source-summary">{data.ukFco.summary}</p>
          <a href={data.ukFco.url} target="_blank" rel="noopener noreferrer" class="source-link">
            View FCO advice →
          </a>
        </div>
        <div class="source-card">
          <div class="source-label">Numbeo Crime Data ({data.numbeo.source})</div>
          <div class="numbeo-stats">
            <div>
              <div class="numbeo-num">{data.numbeo.crimeIndex}</div>
              <div class="numbeo-label">Crime Index</div>
            </div>
            <div>
              <div class="numbeo-num">{data.numbeo.safetyIndex}</div>
              <div class="numbeo-label">Safety Index</div>
            </div>
          </div>
          <a href={`https://www.numbeo.com/crime/in/${data.city.replace(/ /g, '-')}`} target="_blank" rel="noopener noreferrer" class="source-link">
            View Numbeo data →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Emergency Numbers -->
  <section class="emergency-section">
    <div class="container">
      <h2>Emergency Numbers: {data.city}</h2>
      <div class="emergency-grid">
        <div class="emergency-card">
          <div class="emergency-label">Police</div>
          <div class="emergency-number">{data.emergencyNumbers.police}</div>
        </div>
        <div class="emergency-card">
          <div class="emergency-label">Ambulance</div>
          <div class="emergency-number">{data.emergencyNumbers.ambulance}</div>
        </div>
        <div class="emergency-card">
          <div class="emergency-label">Fire</div>
          <div class="emergency-number">{data.emergencyNumbers.fire}</div>
        </div>
        {data.emergencyNumbers.touristHelpline && (
          <div class="emergency-card">
            <div class="emergency-label">Tourist Helpline</div>
            <div class="emergency-number emergency-number--small">{data.emergencyNumbers.touristHelpline}</div>
          </div>
        )}
        {data.emergencyNumbers.lagosStateEmergency && (
          <div class="emergency-card">
            <div class="emergency-label">Lagos State Emergency</div>
            <div class="emergency-number">{data.emergencyNumbers.lagosStateEmergency}</div>
          </div>
        )}
        {data.emergencyNumbers.capeTownEmergency && (
          <div class="emergency-card">
            <div class="emergency-label">Cape Town Emergency</div>
            <div class="emergency-number emergency-number--small">{data.emergencyNumbers.capeTownEmergency}</div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Embassy Contacts -->
  <section class="embassy-section">
    <div class="container">
      <h2>Embassy Contacts</h2>
      <div class="embassy-grid">
        <div class="embassy-card">
          <div class="embassy-label">United States</div>
          <div class="embassy-name">{data.embassyContacts.us.name}</div>
          <div class="embassy-phone">{data.embassyContacts.us.phone}</div>
          <a href={data.embassyContacts.us.url} target="_blank" rel="noopener noreferrer" class="embassy-link">Embassy website →</a>
        </div>
        <div class="embassy-card">
          <div class="embassy-label">United Kingdom</div>
          <div class="embassy-name">{data.embassyContacts.uk.name}</div>
          <div class="embassy-phone">{data.embassyContacts.uk.phone}</div>
          <a href={data.embassyContacts.uk.url} target="_blank" rel="noopener noreferrer" class="embassy-link">High Commission website →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights / Challenges -->
  <section class="hc-section">
    <div class="container">
      <div class="hc-grid">
        <div>
          <h2>Highlights</h2>
          <ul class="hc-list hc-highlights">
            {data.highlights.map((h: string) => <li>{h}</li>)}
          </ul>
        </div>
        <div>
          <h2>Challenges</h2>
          <ul class="hc-list hc-challenges">
            {data.challenges.map((c: string) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Nomad Cities Crosslink -->
  <section class="crosslink-section">
    <div class="container container--narrow">
      <p class="crosslink-text">
        Planning a move to {data.city}? See cost of living, wifi speeds, visa requirements, and coworking spaces.{' '}
        <a href={data.nomadCitiesUrl}>{data.city} nomad city profile →</a>
      </p>
    </div>
  </section>

  <!-- Back to Directory -->
  <section class="back-section">
    <div class="container">
      <a href="/directories/safety-intel" class="back-link">← All cities in the Safety Intel directory</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .city-hero {
    background: var(--color-black);
    padding: var(--space-2xl) 0 var(--space-3xl);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.4);
    margin-bottom: var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: rgba(255,255,255,0.5);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: rgba(255,255,255,0.8);
  }

  .breadcrumb span:not(:last-child) {
    color: rgba(255,255,255,0.3);
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .city-flag {
    font-size: 3rem;
    line-height: 1;
  }

  .city-region {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.5);
    margin-bottom: var(--space-xs);
  }

  .city-hero h1 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    color: #fff;
    line-height: 1.1;
    margin: 0;
  }

  .score-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-xl);
  }

  .score-block {
    text-align: center;
  }

  .score-number {
    font-size: 2rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: rgba(255,255,255,0.9);
    line-height: 1;
    margin-bottom: 4px;
  }

  .score-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    line-height: 1.4;
  }

  .score-sub {
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.35);
    text-transform: none;
    letter-spacing: 0;
  }

  .risk-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid;
    margin-bottom: var(--space-xl);
  }

  .hero-summary {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    max-width: 800px;
    margin: 0;
  }

  /* Western comparison block */
  .context-comparison {
    border: 1px solid rgba(255,255,255,0.12);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    background: rgba(255,255,255,0.03);
  }

  .comparison-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin-bottom: var(--space-md);
  }

  .comparison-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .comparison-city {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .comparison-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
  }

  .comparison-score {
    font-size: 1.375rem;
    font-weight: 700;
    font-family: var(--font-heading);
    line-height: 1;
  }

  .comparison-city--african .comparison-score {
    color: rgba(255,255,255,0.9);
  }

  .comparison-city--western .comparison-score {
    color: rgba(255,255,255,0.45);
  }

  .comparison-city--western .comparison-name {
    color: rgba(255,255,255,0.5);
  }

  .comparison-vs {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.3);
    padding: 0 var(--space-xs);
  }

  .comparison-note {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.6;
    margin: 0;
    font-style: italic;
  }


  .alerts-section {
    padding: var(--space-2xl) 0;
    background: rgba(239, 68, 68, 0.06);
    border-bottom: 1px solid rgba(239, 68, 68, 0.2);
  }

  .alerts-section h2 {
    margin-bottom: var(--space-xl);
    color: #ef4444;
  }

  .alerts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .alert-item {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .alert-icon {
    color: #f97316;
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .alert-item p {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin: 0;
  }

  /* Zones */
  .zones-section {
    padding: var(--space-3xl) 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .zones-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .zone-block {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
  }

  .zone-safe {
    border-left: 3px solid #22c55e;
  }

  .zone-caution {
    border-left: 3px solid #ef4444;
  }

  .zone-block h2 {
    margin-bottom: var(--space-xs);
    font-size: 1.25rem;
  }

  .zone-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .zone-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .zone-block li {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.8);
    padding-left: var(--space-md);
    position: relative;
  }

  .zone-safe li::before {
    content: '✓';
    color: #22c55e;
    position: absolute;
    left: 0;
    font-size: 0.75rem;
    top: 2px;
  }

  .zone-caution li::before {
    content: '!';
    color: #f97316;
    position: absolute;
    left: 2px;
    font-size: 0.75rem;
    font-weight: 700;
    top: 2px;
  }

  /* Crime & Tips */
  .crime-section,
  .tips-section,
  .facts-section {
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-black);
  }

  .section-intro {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: var(--space-xl);
  }

  .crime-list,
  .facts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .crime-list li,
  .facts-list li {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.5;
    padding-left: var(--space-lg);
    position: relative;
  }

  .crime-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: rgba(255,255,255,0.4);
    font-size: 1.25rem;
    top: -4px;
  }

  .facts-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: rgba(255,255,255,0.4);
    font-size: 0.75rem;
    top: 3px;
  }

  .tips-list {
    padding-left: 0;
    counter-reset: tips;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .tips-list li {
